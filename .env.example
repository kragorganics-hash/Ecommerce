# Environment Variables Example for Krag Organic Full-Stack E-Commerce

# Database Configuration
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production (Supabase / Neon / Railway / AWS RDS):
# DATABASE_URL="postgresql://user:password@localhost:5432/krag_organic?schema=public"

# Authentication & Session Security (Generate high entropy strings in production)
JWT_SECRET="your-32-character-secret-jwt-key"
COOKIE_SECRET="your-32-character-cookie-secret"

# App & Store Info
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Krag Organic"
NEXT_PUBLIC_STORE_CURRENCY="NPR"
NEXT_PUBLIC_STORE_CURRENCY_SYMBOL="Rs. "

# Nepal Payment Gateways Sandbox / Live
# eSewa Configuration (Use EPAYTEST for sandbox)
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="your-esewa-secret-key"
ESEWA_PAYMENT_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form"
ESEWA_VERIFY_URL="https://rc.esewa.com.np/mobile/ecode"

# Khalti Configuration
KHALTI_PUBLIC_KEY="your-khalti-public-key"
KHALTI_SECRET_KEY="your-khalti-secret-key"
KHALTI_API_URL="https://a.khalti.com/api/v2"

# Security Admin Setup Key
ADMIN_SETUP_SECRET="your-secure-admin-setup-secret"
